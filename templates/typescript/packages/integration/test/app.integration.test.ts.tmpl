import { renderHelloWorld } from "@{{package_scope}}/client"
import { createConnectionString } from "@{{package_scope}}/db"
import { buildServerBanner } from "@{{package_scope}}/server"

describe("integration", () => {
  it("wires the workspace packages together", () => {
    expect({
      client: renderHelloWorld("world"),
      database: createConnectionString("service"),
      server: buildServerBanner("world"),
    }).toEqual({
      client: "Hello, world!",
      database: "postgres://localhost:5432/service",
      server: "Hello, world! Connected to postgres://localhost:5432/service",
    })
  })
})
