{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "tsBuildInfoFile": "tsconfig.tsbuildinfo"
  },
  "references": [
    { "path": "../client/tsconfig.build.json" },
    { "path": "../db/tsconfig.build.json" },
    { "path": "../server/tsconfig.build.json" }
  ],
  "include": ["src/**/*.ts"],
  "exclude": ["test/**/*.ts", "dist", "coverage", "node_modules"]
}
