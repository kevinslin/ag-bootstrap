{
  "name": "{{package_name}}",
  "version": "0.1.0",
  "private": true,
  "description": "{{description}}",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "lerna run build --stream",
    "clean": "lerna run clean --stream && rimraf .nx",
    "dev": "lerna run dev --parallel --stream",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "graph": "nx graph",
    "lint": "NX_DAEMON=false nx run-many -t lint --all --parallel=3",
    "list": "lerna list --all",
    "prepare": "husky",
    "test": "NX_DAEMON=false nx run-many -t test --all --parallel=1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.5.2",
    "eslint": "^9.14.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.11.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lerna": "^8.1.8",
    "nx": "19.8.4",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.13.0"
  }
}
